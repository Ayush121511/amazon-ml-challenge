#!/bin/bash
#PBS -N er_big
#PBS -P scai
#PBS -q scai_q
#PBS -l select=1:ncpus=4:ngpus=1:mem=48gb:centos=amdepyc
#PBS -l walltime=05:00:00
#PBS -j oe
# CPU-only; the GPU is requested only because scai_q requires one per job.
# Retrain the matcher on saved pairs with more capacity (same dev/holdout), then loss analysis.
# Usage: qsub -v PAIRS=artifacts/matcher_v2/pairs,OUT=artifacts/matcher_v2/model_k200_big padum/train_big.pbs
set -euo pipefail
cd "$HOME/scratch/amazon_ml_2026"
test -n "${PBS_JOBID:-}" && test -n "${PAIRS:-}" && test -n "${OUT:-}"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
PY="$PWD/.conda-er/bin/python"
N="${NCPUS:-4}"
SRC=business_entity_resolution/src
"$PY" -u $SRC/submission_pipeline.py train --pairs "$PAIRS" --output "$OUT" --max-rank 200 \
  --rounds 4000 --num-leaves 127 --learning-rate 0.06 --min-data-in-leaf 50 --early-stopping 100 --threads "$N"
"$PY" -u $SRC/analyze_matcher_loss.py --pairs "$PAIRS" --model "$OUT" --output "$OUT/loss_analysis"
