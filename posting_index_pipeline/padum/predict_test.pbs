#!/bin/bash
#PBS -N er_predict
#PBS -P scai
#PBS -q scai_q
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb:centos=amdepyc
#PBS -l walltime=06:00:00
#PBS -j oe
# CPU-only; the GPU is requested only because scai_q requires one per job.
# Test inference. SAMPLE=N runs a random subset first (no validation: a subset cannot cover every
# reference). REVERSE=1 adds reverse blocking (needs test_ref_index + test_reverse).
# Usage: qsub -v MODEL=artifacts/matcher_v1/model_k100,RUN=trial_v1,SAMPLE=100000 padum/predict_test.pbs
# Full test in 2 parallel shards: SHARD=0/2,RUN=full_v2_s0 and SHARD=1/2,RUN=full_v2_s1, then merge_test.pbs.
set -euo pipefail
cd "$HOME/scratch/amazon_ml_2026"
test -n "${PBS_JOBID:-}" && test -n "${MODEL:-}" && test -n "${RUN:-}"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
PYTHON="$PWD/.conda-er/bin/python"
OUT=artifacts/$RUN
PIDX=artifacts/posting_index_v1
EXTRA=()
if [ -n "${SAMPLE:-}" ]; then EXTRA+=(--sample "$SAMPLE"); fi
if [ -n "${SHARD:-}" ]; then EXTRA+=(--shard "$SHARD"); fi
if [ -n "${REVERSE:-}" ]; then EXTRA+=(--ref-index $PIDX/test_ref_index --reverse $PIDX/test_reverse_t); fi
/usr/bin/time -v "$PYTHON" -u business_entity_resolution/src/submission_pipeline.py predict \
  --data artifacts/preprocessed_v2/test --index $PIDX/${INDEX:-test_index_t} \
  --split test --model "$MODEL" --output "$OUT" --top-k 200 --top-terms 64 --threads 8 "${EXTRA[@]}"
if [ -z "${SAMPLE:-}" ] && [ -z "${SHARD:-}" ]; then
  SR=6ab10eb3b23ba_student_resource/student_resource
  "$PYTHON" $SR/utils/validate_submission.py --matching "$OUT/matching_results.tsv" \
    --candidate "$OUT/candidate_pairs.tsv" --test-dir $SR/dataset/test --check-ids
fi
ls -l "$OUT"
