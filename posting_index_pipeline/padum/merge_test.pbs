#!/bin/bash
#PBS -N er_merge
#PBS -P scai
#PBS -q scai_q
#PBS -l select=1:ncpus=2:ngpus=1:mem=120gb:centos=amdepyc
#PBS -l walltime=02:00:00
#PBS -j oe
# CPU-only; the GPU is requested only because scai_q requires one per job.
# Merge predict shards (global exclusivity + decision rule), write both TSVs, validate.
# Usage: qsub -v MODEL=artifacts/matcher_v4/model_xgb,RUN=submission_v4_final,SHARDS=artifacts/full_v4_s0:artifacts/full_v4_s1 padum/merge_test.pbs
#        (SHARDS separated by ":" because qsub -v splits on commas; optional COUNTRY_THRESHOLD=France=0.6)
set -euo pipefail
cd "$HOME/scratch/amazon_ml_2026"
test -n "${PBS_JOBID:-}" && test -n "${MODEL:-}" && test -n "${RUN:-}" && test -n "${SHARDS:-}"
PYTHON="$PWD/.conda-er/bin/python"
OUT=artifacts/$RUN
/usr/bin/time -v "$PYTHON" -u business_entity_resolution/src/submission_pipeline.py merge \
  --data artifacts/preprocessed_v2/test --split test --model "$MODEL" --shards ${SHARDS//:/ } --output "$OUT" \
  ${COUNTRY_THRESHOLD:+--country-threshold "$COUNTRY_THRESHOLD"}
SR=6ab10eb3b23ba_student_resource/student_resource
echo "=== validator: both files, all format rules + matches within candidates"
"$PYTHON" $SR/utils/validate_submission.py --matching "$OUT/matching_results.tsv" \
  --candidate "$OUT/candidate_pairs.tsv" --test-dir $SR/dataset/test
echo "=== validator: matching file, every ID exists in the test set"
"$PYTHON" $SR/utils/validate_submission.py --matching "$OUT/matching_results.tsv" \
  --candidate /nonexistent --test-dir $SR/dataset/test --check-ids
ls -l "$OUT"
