#!/bin/bash
#PBS -N er_v3_train
#PBS -P scai
#PBS -q scai_q
#PBS -l select=1:ncpus=4:ngpus=1:mem=48gb:centos=amdepyc
#PBS -l walltime=10:00:00
#PBS -j oe
# CPU-only; the GPU is requested only because scai_q requires one per job.
# v3 = v2 + the routes chosen by the route check (phonetic and/or combined). Reuses
# train_index_c (built by route_check.pbs), builds test_index_c with the same routes, then pairs
# on the SAME 100k references as v2 (seed matcher-v2) and trains K=200 with LightGBM settings
# given by LGB_ARGS (default: v2's). Target ordinals are unchanged, so the v2 reverse outputs
# stay valid. Usage: qsub -v ROUTES=name:address:anchor:combined padum/v3_train_chain.pbs  (":" not ",": qsub -v splits on commas)
set -euo pipefail
cd "$HOME/scratch/amazon_ml_2026"
test -n "${PBS_JOBID:-}"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
PY="$PWD/.conda-er/bin/python"
N="${NCPUS:-4}"; W=$(( N > 1 ? N - 1 : 1 ))
SRC=business_entity_resolution/src
PIDX=artifacts/posting_index_v1
PREV=$PIDX/previous_samples
GOLD=6ab10eb3b23ba_student_resource/student_resource/dataset/train/train_ground_truth.tsv
(cd business_entity_resolution && "$PY" -m unittest discover -s tests)
test -f $PIDX/train_index_c/manifest.json
OUT=artifacts/matcher_v3
/usr/bin/time -v "$PY" -u $SRC/submission_pipeline.py pairs \
  --data artifacts/preprocessed_v2/train --index $PIDX/train_index_c \
  --ref-index $PIDX/train_ref_index --reverse $PIDX/train_reverse_t \
  --output $OUT/pairs --gold $GOLD --per-country 50000 --seed matcher-v2 \
  --top-k 200 --top-terms 64 --keep 200 --threads "$N" ${ROUTES:+--routes ${ROUTES//:/,}} \
  --exclude-ids $PREV/retrieval_v1_ids.txt --exclude-ids $PREV/sparse_fullpool_ids.txt \
  --exclude-ids $PREV/selective_index_v1_ids.txt --exclude-ids $PIDX/train_query_10000/reference_ids.txt
"$PY" -u $SRC/submission_pipeline.py train --pairs $OUT/pairs --output $OUT/model_k200 \
  --max-rank 200 --rounds 4000 --threads "$N" ${LGB_ARGS:-}
"$PY" -u $SRC/analyze_matcher_loss.py --pairs $OUT/pairs --model $OUT/model_k200 --output $OUT/model_k200/loss_analysis
# Test index with the same routes, ready for prediction (same ordinals as test_index_t).
test -e $PIDX/test_index_c || "$PY" -u $SRC/posting_index.py --data artifacts/preprocessed_v2/test \
  --split test --output $PIDX/test_index_c --workers "$W" --chunk-rows 50000 --max-df-fraction 0.005 --min-max-df 1000
