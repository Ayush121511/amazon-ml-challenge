#!/bin/bash
#PBS -N er_routes
#PBS -P scai
#PBS -q scai_q
#PBS -l select=1:ncpus=4:ngpus=1:mem=48gb:centos=amdepyc
#PBS -l walltime=03:00:00
#PBS -j oe
# CPU-only; the GPU is requested only because scai_q requires one per job.
# Route check: build the train target index with the phonetic + combined routes, then compare
# forward candidate recall of route combinations on 20k of v2's references (labels read last).
# Usage: qsub padum/route_check.pbs
set -euo pipefail
cd "$HOME/scratch/amazon_ml_2026"
test -n "${PBS_JOBID:-}"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
PY="$PWD/.conda-er/bin/python"
N="${NCPUS:-4}"; W=$(( N > 1 ? N - 1 : 1 ))
SRC=business_entity_resolution/src
PIDX=artifacts/posting_index_v1
(cd business_entity_resolution && "$PY" -m unittest discover -s tests)
test -e $PIDX/train_index_c || /usr/bin/time -v "$PY" -u $SRC/posting_index.py --data artifacts/preprocessed_v2/train \
  --split train --output $PIDX/train_index_c --workers "$W" --chunk-rows 50000 --max-df-fraction 0.005 --min-max-df 1000
cd $SRC && /usr/bin/time -v "$PY" -u blocking_recall.py --data ../../artifacts/preprocessed_v2/train \
  --index ../../$PIDX/train_index_c \
  --gold ../../6ab10eb3b23ba_student_resource/student_resource/dataset/train/train_ground_truth.tsv \
  --reference-ids ../../artifacts/matcher_v2/pairs/reference_ids.txt --sample 20000 \
  --output ../../artifacts/route_check_v1 --threads "$N"
