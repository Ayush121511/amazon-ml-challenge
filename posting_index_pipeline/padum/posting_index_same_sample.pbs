#!/bin/bash
#PBS -N er_pidx_same
#PBS -P scai
#PBS -q scai_q
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb:centos=amdepyc
#PBS -l walltime=01:00:00
#PBS -j oe
# CPU-only; the GPU is requested only because scai_q requires one per job.
# Same-sample check: query the 400 sparse_fullpool references with the train posting index.
# Usage: qsub padum/posting_index_same_sample.pbs
set -euo pipefail
cd "$HOME/scratch/amazon_ml_2026"
test -n "${PBS_JOBID:-}"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
PYTHON="$PWD/.conda-er/bin/python"
OUT=artifacts/posting_index_v1/train_query_sparse_fullpool
SAMPLES=artifacts/posting_index_v1/previous_samples
(cd business_entity_resolution && "$PYTHON" -m unittest discover -s tests)
"$PYTHON" -u business_entity_resolution/src/export_previous_samples.py \
  --source1 artifacts/preprocessed_v2/train/train_source1.tsv.gz --output "$SAMPLES"
/usr/bin/time -v "$PYTHON" -u business_entity_resolution/src/posting_index_benchmark.py \
  --data artifacts/preprocessed_v2/train --split train \
  --index artifacts/posting_index_v1/train_index \
  --output "$OUT" --reference-ids "$SAMPLES/sparse_fullpool_ids.txt" \
  --top-k 100 --top-terms 32 --batch 4096 --threads 8 \
  --gold 6ab10eb3b23ba_student_resource/student_resource/dataset/train/train_ground_truth.tsv
