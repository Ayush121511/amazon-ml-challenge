#!/bin/bash
#PBS -N er_pidx_sweep
#PBS -P scai
#PBS -q scai_q
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb:centos=amdepyc
#PBS -l walltime=02:00:00
#PBS -j oe
# CPU-only; the GPU is requested only because scai_q requires one per job.
# Query-time sweep of --top-terms x --top-k on the 2,000 retrieval_v1 references (tuning set,
# disjoint from the sparse_fullpool 400 comparison and the 20k posting_index_v1 evaluation).
# Needs artifacts/posting_index_v1/previous_samples from posting_index_same_sample.pbs.
# Usage: qsub padum/posting_index_sweep.pbs
set -euo pipefail
cd "$HOME/scratch/amazon_ml_2026"
test -n "${PBS_JOBID:-}"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
PYTHON="$PWD/.conda-er/bin/python"
IDS=artifacts/posting_index_v1/previous_samples/retrieval_v1_ids.txt
for TERMS in 32 64 128; do
  for TOPK in 100 200; do
    OUT=artifacts/posting_index_v1/sweep_retrieval_v1/terms${TERMS}_k${TOPK}
    echo "=== top-terms $TERMS top-k $TOPK -> $OUT"
    "$PYTHON" -u business_entity_resolution/src/posting_index_benchmark.py \
      --data artifacts/preprocessed_v2/train --split train \
      --index artifacts/posting_index_v1/train_index \
      --output "$OUT" --reference-ids "$IDS" \
      --top-k "$TOPK" --top-terms "$TERMS" --batch 4096 --threads 8 \
      --gold 6ab10eb3b23ba_student_resource/student_resource/dataset/train/train_ground_truth.tsv \
      > "$OUT.log"
    "$PYTHON" -c "import json,sys; r=json.load(open(sys.argv[1]))
for g in ('all','US','India'):
    m=r['recall'][g]; print(g, 'R@50 %.4f union %.4f cands %.1f' % (m['recall_at_50'], m['union_recall'], m['mean_union_candidates']))
print('query_s %.1f' % r['throughput']['query_seconds'])" "$OUT/report.json"
  done
done
