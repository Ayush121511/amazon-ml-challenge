#!/bin/bash
#PBS -N er_pidx_build
#PBS -P scai
#PBS -q scai_q
#PBS -l select=1:ncpus=8:ngpus=1:mem=48gb:centos=amdepyc
#PBS -l walltime=04:00:00
#PBS -j oe
# CPU-only; the GPU is requested only because scai_q requires one per job.
# Usage: qsub -v SPLIT=train padum/posting_index_build.pbs   (or SPLIT=test)
set -euo pipefail
cd "$HOME/scratch/amazon_ml_2026"
test -n "${PBS_JOBID:-}"
SPLIT="${SPLIT:-train}"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
PYTHON="$PWD/.conda-er/bin/python"
"$PYTHON" -m unittest discover -s business_entity_resolution/tests
/usr/bin/time -v "$PYTHON" -u business_entity_resolution/src/posting_index.py \
  --data artifacts/preprocessed_v2/$SPLIT --split $SPLIT \
  --output artifacts/posting_index_v1/${SPLIT}_index \
  --workers 7 --chunk-rows 50000 --max-df-fraction 0.005 --min-max-df 1000
