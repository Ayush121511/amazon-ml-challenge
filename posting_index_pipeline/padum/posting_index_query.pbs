#!/bin/bash
#PBS -N er_pidx_query
#PBS -P scai
#PBS -q scai_q
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb:centos=amdepyc
#PBS -l walltime=03:00:00
#PBS -j oe
# CPU-only; the GPU is requested only because scai_q requires one per job.
# Usage: qsub -v SPLIT=train padum/posting_index_query.pbs   (or SPLIT=test)
set -euo pipefail
cd "$HOME/scratch/amazon_ml_2026"
test -n "${PBS_JOBID:-}"
SPLIT="${SPLIT:-train}"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
PYTHON="$PWD/.conda-er/bin/python"
GOLD=()
if [ "$SPLIT" = train ]; then
  GOLD=(--gold 6ab10eb3b23ba_student_resource/student_resource/dataset/train/train_ground_truth.tsv)
fi
/usr/bin/time -v "$PYTHON" -u business_entity_resolution/src/posting_index_benchmark.py \
  --data artifacts/preprocessed_v2/$SPLIT --split $SPLIT \
  --index artifacts/posting_index_v1/${SPLIT}_index \
  --output artifacts/posting_index_v1/${SPLIT}_query_${PER_COUNTRY:-10000} \
  --per-country "${PER_COUNTRY:-10000}" --top-k 100 --top-terms 32 --batch 4096 --threads 8 \
  "${GOLD[@]}"
