#!/bin/bash
#PBS -N er_loss
#PBS -P scai
#PBS -q scai_q
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb:centos=amdepyc
#PBS -l walltime=00:45:00
#PBS -j oe
# CPU-only; the GPU is requested only because scai_q requires one per job.
# Usage: qsub -v PAIRS=artifacts/matcher_v1/pairs,MODEL=artifacts/matcher_v1/model_k200 padum/analyze_loss.pbs
set -euo pipefail
cd "$HOME/scratch/amazon_ml_2026"
test -n "${PBS_JOBID:-}"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
"$PWD/.conda-er/bin/python" -u business_entity_resolution/src/analyze_matcher_loss.py \
  --pairs "$PAIRS" --model "$MODEL" --output "$MODEL/loss_analysis"
