flowchart LR
    IN[/"Test files<br/>Sources 1, 2, 3"/]
    subgraph BLK["BLOCKER · Stage 1"]
        direction TB
        B1["Retrieval<br/>lexical TF-IDF + dense embeddings,<br/>in both directions"]
        B2["Pruning<br/>a ranker keeps the<br/>top 10 per business"]
        B3["Recall extensions<br/>rescue of ranks 11–20: only the plausible ones,<br/>accepted only if all cross-encoders are sure<br/>+ address-based rules"]
        B1 --> B2 --> B3
    end
    CP[("candidate_pairs.tsv")]
    subgraph MAT["MATCHER · Stages 2–3"]
        direction TB
        M1["Stage 2 · Pair scoring<br/>feature matcher + cross-encoders,<br/>fused into one probability"]
        M2["Stage 3 · Decision model<br/>reads each business's whole list<br/>and who else could own each record"]
        M3["Post-processing<br/>one business per record,<br/>France-specific rules"]
        M1 --> M2 --> M3
    end
    OUT[/"matching_results.tsv"/]
    IN --> BLK
    BLK -->|"<b>10.07 candidates per S1</b><br/>top 10 + 0.07 from<br/>recall extensions<br/>(17,441,360 pairs)"| CP
    CP --> MAT --> OUT

    classDef blk fill:#e8f0fe,stroke:#3b6fd8,color:#0b1f44
    classDef mat fill:#e7f6ec,stroke:#2e8b57,color:#0d2b1a
    classDef io fill:#f3f3f3,stroke:#555,color:#111
    class B1,B2,B3 blk
    class M1,M2,M3 mat
    class IN,CP,OUT io
    style BLK fill:#f7f9ff,stroke:#3b6fd8,stroke-width:2px
    style MAT fill:#f5fbf7,stroke:#2e8b57,stroke-width:2px
