#!/bin/bash
#PBS -N er_reverse
#PBS -P scai
#PBS -q scai_q
#PBS -l select=1:ncpus=8:ngpus=1:mem=48gb:centos=amdepyc
#PBS -l walltime=12:00:00
#PBS -j oe
# CPU-only; the GPU is requested only because scai_q requires one per job.
# Reference (Source 1) indexes + reverse search of every target, for SPLITS (default "train test").
# Usage: qsub padum/reverse_index.pbs
set -euo pipefail
cd "$HOME/scratch/amazon_ml_2026"
test -n "${PBS_JOBID:-}"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
PYTHON="$PWD/.conda-er/bin/python"
(cd business_entity_resolution && "$PYTHON" -m unittest discover -s tests)
for SPLIT in ${SPLITS:-train test}; do
  REF=artifacts/posting_index_v1/${SPLIT}_ref_index
  test -e "$REF" || "$PYTHON" -u business_entity_resolution/src/posting_index.py \
    --data artifacts/preprocessed_v2/$SPLIT --split $SPLIT --sources 1 --output "$REF" \
    --workers 7 --chunk-rows 50000 --max-df-fraction 0.005 --min-max-df 1000
  /usr/bin/time -v "$PYTHON" -u business_entity_resolution/src/reverse_index.py \
    --ref-index "$REF" --target-index artifacts/posting_index_v1/${SPLIT}_index \
    --output artifacts/posting_index_v1/${SPLIT}_reverse --top-k 50 --top-terms 64 --keep 10 --threads 8
done
