#!/bin/bash
#PBS -N er_sparse_100k
#PBS -P scai
#PBS -q scai_q
#PBS -l select=1:ncpus=4:ngpus=1:mem=16gb:centos=amdepyc
#PBS -l walltime=04:00:00
#PBS -j oe
set -euo pipefail
cd "$HOME/scratch/amazon_ml_2026"
test -n "${PBS_JOBID:-}"
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4
.conda-er/bin/python -m unittest discover -s business_entity_resolution/tests -q
.conda-er/bin/python -u business_entity_resolution/src/sparse_fullpool.py \
 --data artifacts/preprocessed_v2/train \
 --exclude artifacts/retrieval_v1/references.json \
 --exclude-additional artifacts/sparse_fullpool_v1/references.json \
 --exclude-additional artifacts/selective_index_v1/references.json \
 --gold 6ab10eb3b23ba_student_resource/student_resource/dataset/train/train_ground_truth.tsv \
 --output artifacts/sparse_compact_100k --per-country 50000 --fit-rows 20000 \
 --chunk-rows 50000 --top-k 100 --threads 4 --compact-topk --query-batch 5000
